# Lemon Squeezy checkout. Copy to .env.local and fill in from the Lemon Squeezy
# dashboard: Products → (variant) → Share → copy the checkout link.
#
# Use test-mode links locally. Leave these unset and the buy buttons fall back
# to enquiry links.

VITE_LS_CHECKOUT_STARTUP=https://richkit.lemonsqueezy.com/buy/00000000-0000-0000-0000-000000000000
VITE_LS_CHECKOUT_BUSINESS=https://richkit.lemonsqueezy.com/buy/00000000-0000-0000-0000-000000000000
VITE_LS_CHECKOUT_LIFETIME=https://richkit.lemonsqueezy.com/buy/00000000-0000-0000-0000-000000000000

# RichKit Pro key for the showcase demos (pnpm license:mint ... --domains faithdevss.github.io).
# Not needed on localhost, where Pro runs without a key.
VITE_RICHKIT_LICENSE_KEY=
