# Paddle checkout. Copy to .env.local and fill in from the Paddle dashboard:
# Developer tools → Authentication → Client-side tokens.
#
# The domain serving this bundle must also be approved under
# Checkout → Website approval, or Paddle refuses to open the overlay.

VITE_PADDLE_ENV=sandbox
VITE_PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxxxxxxxxxxx

# Sandbox price IDs for "RichKit Commercial Licence" (pro_01m2racdpdtasv0wsec3b0pev8).
VITE_PADDLE_PRICE_ANNUAL=pri_01m2racdyqg92z91kj1krmg2ez
VITE_PADDLE_PRICE_LIFETIME=pri_01m2radgk06rs33r19ja7pw7xr
