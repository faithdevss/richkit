{
  "name": "@richkitjs/core",
  "version": "0.1.0",
  "description": "Headless, framework-agnostic rich text editor built on ProseMirror. Extension API, schema builder, chainable commands, HTML/JSON I/O and autosave. 64 KB gzipped.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "scripts",
    "LICENSE",
    "LICENSE-COMMERCIAL",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "docs": "typedoc",
    "clean": "rm -rf dist .turbo docs",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "dependencies": {
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.3",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.1",
    "prosemirror-view": "^1.42.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "jsdom": "^30.1.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faithdevss/richkit.git",
    "directory": "packages/core"
  },
  "homepage": "https://faithdevss.github.io/richkit/",
  "bugs": {
    "url": "https://github.com/faithdevss/richkit/issues"
  },
  "sideEffects": false,
  "keywords": [
    "richkit",
    "rich-text",
    "rich-text-editor",
    "text-editor",
    "editor",
    "wysiwyg",
    "prosemirror",
    "headless",
    "headless-editor",
    "block-editor",
    "notion-like",
    "document-editor",
    "contenteditable",
    "typescript",
    "framework-agnostic",
    "extensible",
    "html",
    "json"
  ]
}
