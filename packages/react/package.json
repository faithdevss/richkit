{
  "name": "@richkit/react",
  "version": "0.0.0",
  "description": "React bindings for @richkit/core",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.12",
    "@richkit/core": "workspace:*",
    "@richkit/docx": "workspace:*",
    "@richkit/extension-ai": "workspace:*",
    "@richkit/extension-comments": "workspace:*",
    "@richkit/extension-find-replace": "workspace:*",
    "@richkit/extension-slash-commands": "workspace:*",
    "@richkit/extension-track-changes": "workspace:*",
    "@richkit/markdown": "workspace:*",
    "prosemirror-model": "^1.24.1",
    "prosemirror-state": "^1.4.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faithdevss/rich_editor.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/faithdevss/rich_editor#readme",
  "bugs": {
    "url": "https://github.com/faithdevss/rich_editor/issues"
  },
  "sideEffects": false,
  "keywords": [
    "rich-text",
    "editor",
    "wysiwyg",
    "prosemirror",
    "react"
  ]
}
