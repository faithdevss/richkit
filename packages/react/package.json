{
  "name": "@richkitjs/react",
  "version": "0.3.0",
  "description": "React 18/19 bindings for RichKit: useEditor hook, EditorContent, ready-made DefaultToolbar, BubbleMenu, table/link/image/color menus and EditorProvider.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@richkitjs/core": "workspace:*",
    "@richkitjs/docx": "workspace:*",
    "@richkitjs/extension-ai": "workspace:*",
    "@richkitjs/extension-comments": "workspace:*",
    "@richkitjs/extension-drag-handle": "workspace:*",
    "@richkitjs/extension-find-replace": "workspace:*",
    "@richkitjs/extension-mention": "workspace:*",
    "@richkitjs/extension-slash-commands": "workspace:*",
    "@richkitjs/extension-track-changes": "workspace:*",
    "@richkitjs/markdown": "workspace:*",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faithdevss/richkit.git",
    "directory": "packages/react"
  },
  "homepage": "https://faithdevss.github.io/richkit/",
  "bugs": {
    "url": "https://github.com/faithdevss/richkit/issues"
  },
  "sideEffects": false,
  "keywords": [
    "richkit",
    "rich-text",
    "rich-text-editor",
    "text-editor",
    "editor",
    "wysiwyg",
    "prosemirror",
    "headless",
    "headless-editor",
    "block-editor",
    "notion-like",
    "document-editor",
    "contenteditable",
    "typescript",
    "react",
    "react-component",
    "react-hooks",
    "toolbar",
    "bubble-menu",
    "react-editor"
  ]
}
