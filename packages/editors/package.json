{
  "name": "@richkitjs/editors",
  "version": "0.1.0",
  "description": "Ready-made React editors for RichKit — Notion-style, simple, classic form field, question, Markdown, DOCX and more — each a form input with value/onChange.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./style.css"
  },
  "files": [
    "dist",
    "style.css",
    "LICENSE",
    "LICENSE-COMMERCIAL",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@richkitjs/core": "workspace:*",
    "@richkitjs/docx": "workspace:*",
    "@richkitjs/extension-ai": "workspace:*",
    "@richkitjs/extension-find-replace": "workspace:*",
    "@richkitjs/extension-math": "workspace:*",
    "@richkitjs/extension-mention": "workspace:*",
    "@richkitjs/extension-placeholder": "workspace:*",
    "@richkitjs/extension-word-count": "workspace:*",
    "@richkitjs/markdown": "workspace:*",
    "@richkitjs/react": "workspace:*",
    "@richkitjs/starter-kit": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faithdevss/richkit.git",
    "directory": "packages/editors"
  },
  "homepage": "https://faithdevss.github.io/richkit/",
  "bugs": {
    "url": "https://github.com/faithdevss/richkit/issues"
  },
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "richkit",
    "rich-text-editor",
    "wysiwyg",
    "react",
    "react-component",
    "notion-like",
    "form",
    "controlled-component"
  ]
}
