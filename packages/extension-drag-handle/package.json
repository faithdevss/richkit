{
  "name": "@richkitjs/extension-drag-handle",
  "version": "0.2.0",
  "description": "Block drag handle and block-level actions for @richkitjs/core",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@richkitjs/core": "workspace:*",
    "prosemirror-model": "^1.24.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.37.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faithdevss/rich_editor.git",
    "directory": "packages/extension-drag-handle"
  },
  "homepage": "https://github.com/faithdevss/rich_editor#readme",
  "bugs": {
    "url": "https://github.com/faithdevss/rich_editor/issues"
  },
  "sideEffects": false,
  "keywords": [
    "rich-text",
    "editor",
    "wysiwyg",
    "prosemirror",
    "drag-handle",
    "notion"
  ]
}
