{
  "name": "@richkitjs/extension-history",
  "version": "0.1.0",
  "description": "Undo and redo for RichKit, with Mod-Z, Mod-Shift-Z and Mod-Y shortcuts and configurable depth and grouping delay.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@richkitjs/core": "workspace:*",
    "prosemirror-history": "^1.5.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faithdevss/richkit.git",
    "directory": "packages/extension-history"
  },
  "homepage": "https://faithdevss.github.io/richkit/",
  "bugs": {
    "url": "https://github.com/faithdevss/richkit/issues"
  },
  "sideEffects": false,
  "keywords": [
    "richkit",
    "rich-text",
    "rich-text-editor",
    "text-editor",
    "editor",
    "wysiwyg",
    "prosemirror",
    "richkit-extension",
    "history",
    "undo",
    "redo"
  ]
}
