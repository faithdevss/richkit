{
  "name": "@richkitjs/extension-paragraph",
  "version": "0.1.0",
  "description": "Paragraph extension for @richkitjs/core",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@richkitjs/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faithdevss/rich_editor.git",
    "directory": "packages/extension-paragraph"
  },
  "homepage": "https://github.com/faithdevss/rich_editor#readme",
  "bugs": {
    "url": "https://github.com/faithdevss/rich_editor/issues"
  },
  "sideEffects": false,
  "keywords": [
    "rich-text",
    "editor",
    "wysiwyg",
    "prosemirror",
    "paragraph"
  ]
}
