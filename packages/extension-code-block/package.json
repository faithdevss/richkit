{
  "name": "@richkitjs/extension-code-block",
  "version": "0.2.0",
  "description": "Code blocks for RichKit with syntax highlighting (16 languages built in, add any highlight.js grammar), language picker, line numbers, copy button and Tab indenting.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-COMMERCIAL",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@richkitjs/core": "workspace:*",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.3"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faithdevss/richkit.git",
    "directory": "packages/extension-code-block"
  },
  "homepage": "https://faithdevss.github.io/richkit/",
  "bugs": {
    "url": "https://github.com/faithdevss/richkit/issues"
  },
  "sideEffects": false,
  "keywords": [
    "richkit",
    "rich-text",
    "rich-text-editor",
    "text-editor",
    "editor",
    "wysiwyg",
    "prosemirror",
    "richkit-extension",
    "code-block",
    "syntax-highlighting",
    "highlight.js",
    "lowlight",
    "code"
  ]
}
