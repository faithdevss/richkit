{
  "name": "@richkitjs/extension-word-count",
  "version": "0.1.0",
  "description": "Live word and character counts for RichKit documents.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-COMMERCIAL",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@richkitjs/core": "workspace:*",
    "prosemirror-model": "^1.24.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.37.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faithdevss/richkit.git",
    "directory": "packages/extension-word-count"
  },
  "homepage": "https://faithdevss.github.io/richkit/",
  "bugs": {
    "url": "https://github.com/faithdevss/richkit/issues"
  },
  "sideEffects": false,
  "keywords": [
    "richkit",
    "rich-text",
    "rich-text-editor",
    "text-editor",
    "editor",
    "wysiwyg",
    "prosemirror",
    "richkit-extension",
    "word-count",
    "character-count",
    "counter"
  ]
}
