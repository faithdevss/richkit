{
  "name": "@richkitjs/vue",
  "version": "0.1.0",
  "description": "Vue 3 bindings for RichKit: useEditor composable, EditorContent component and provide/inject editor context.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-COMMERCIAL",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@richkitjs/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.6",
    "vue": "^3.5.13",
    "jsdom": "^25.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faithdevss/richkit.git",
    "directory": "packages/vue"
  },
  "homepage": "https://faithdevss.github.io/richkit/",
  "bugs": {
    "url": "https://github.com/faithdevss/richkit/issues"
  },
  "sideEffects": false,
  "keywords": [
    "richkit",
    "rich-text",
    "rich-text-editor",
    "text-editor",
    "editor",
    "wysiwyg",
    "prosemirror",
    "headless",
    "headless-editor",
    "block-editor",
    "notion-like",
    "document-editor",
    "contenteditable",
    "typescript",
    "vue",
    "vue3",
    "vue-component",
    "composable",
    "vue-editor"
  ]
}
