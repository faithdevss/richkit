{
  "name": "@richkitjs/extension-line-height",
  "version": "0.1.0",
  "description": "Line height for RichKit paragraphs and headings: setLineHeight and unsetLineHeight commands.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-COMMERCIAL",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@richkitjs/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faithdevss/richkit.git",
    "directory": "packages/extension-line-height"
  },
  "homepage": "https://faithdevss.github.io/richkit/",
  "bugs": {
    "url": "https://github.com/faithdevss/richkit/issues"
  },
  "sideEffects": false,
  "keywords": [
    "richkit",
    "rich-text",
    "rich-text-editor",
    "text-editor",
    "editor",
    "wysiwyg",
    "prosemirror",
    "richkit-extension",
    "line-height",
    "line-spacing",
    "formatting"
  ]
}
