{
  "name": "@richkitjs/starter-kit",
  "version": "0.3.0",
  "description": "Every standard RichKit extension in one import: 41 extensions covering marks, headings, lists, tables, images, code highlighting, callouts, comments, markdown shortcuts and more. 184 KB gzipped.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@richkitjs/core": "workspace:*",
    "@richkitjs/extension-blockquote": "workspace:*",
    "@richkitjs/extension-bold": "workspace:*",
    "@richkitjs/extension-bookmark": "workspace:*",
    "@richkitjs/extension-bullet-list": "workspace:*",
    "@richkitjs/extension-callout": "workspace:*",
    "@richkitjs/extension-case-change": "workspace:*",
    "@richkitjs/extension-code": "workspace:*",
    "@richkitjs/extension-code-block": "workspace:*",
    "@richkitjs/extension-drag-handle": "workspace:*",
    "@richkitjs/extension-embed": "workspace:*",
    "@richkitjs/extension-find-replace": "workspace:*",
    "@richkitjs/extension-hard-break": "workspace:*",
    "@richkitjs/extension-heading": "workspace:*",
    "@richkitjs/extension-highlight": "workspace:*",
    "@richkitjs/extension-history": "workspace:*",
    "@richkitjs/extension-horizontal-rule": "workspace:*",
    "@richkitjs/extension-image": "workspace:*",
    "@richkitjs/extension-italic": "workspace:*",
    "@richkitjs/extension-line-height": "workspace:*",
    "@richkitjs/extension-link": "workspace:*",
    "@richkitjs/extension-list-item": "workspace:*",
    "@richkitjs/extension-markdown-shortcuts": "workspace:*",
    "@richkitjs/extension-media": "workspace:*",
    "@richkitjs/extension-mention": "workspace:*",
    "@richkitjs/extension-ordered-list": "workspace:*",
    "@richkitjs/extension-page-break": "workspace:*",
    "@richkitjs/extension-paragraph": "workspace:*",
    "@richkitjs/extension-paste-handler": "workspace:*",
    "@richkitjs/extension-placeholder": "workspace:*",
    "@richkitjs/extension-slash-commands": "workspace:*",
    "@richkitjs/extension-strike": "workspace:*",
    "@richkitjs/extension-subscript": "workspace:*",
    "@richkitjs/extension-superscript": "workspace:*",
    "@richkitjs/extension-table": "workspace:*",
    "@richkitjs/extension-task-list": "workspace:*",
    "@richkitjs/extension-text-align": "workspace:*",
    "@richkitjs/extension-text-style": "workspace:*",
    "@richkitjs/extension-toggle": "workspace:*",
    "@richkitjs/extension-typography": "workspace:*",
    "@richkitjs/extension-underline": "workspace:*",
    "@richkitjs/extension-word-count": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faithdevss/richkit.git",
    "directory": "packages/starter-kit"
  },
  "homepage": "https://faithdevss.github.io/richkit/",
  "bugs": {
    "url": "https://github.com/faithdevss/richkit/issues"
  },
  "sideEffects": false,
  "keywords": [
    "richkit",
    "rich-text",
    "rich-text-editor",
    "text-editor",
    "editor",
    "wysiwyg",
    "prosemirror",
    "headless",
    "headless-editor",
    "block-editor",
    "notion-like",
    "document-editor",
    "contenteditable",
    "typescript",
    "starter-kit",
    "extensions",
    "tables",
    "markdown",
    "code-highlighting"
  ]
}
