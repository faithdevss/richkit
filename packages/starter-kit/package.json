{
  "name": "@richkit/starter-kit",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@richkit/core": "workspace:*",
    "@richkit/extension-blockquote": "workspace:*",
    "@richkit/extension-bold": "workspace:*",
    "@richkit/extension-bullet-list": "workspace:*",
    "@richkit/extension-case-change": "workspace:*",
    "@richkit/extension-code": "workspace:*",
    "@richkit/extension-code-block": "workspace:*",
    "@richkit/extension-comments": "workspace:*",
    "@richkit/extension-embed": "workspace:*",
    "@richkit/extension-find-replace": "workspace:*",
    "@richkit/extension-heading": "workspace:*",
    "@richkit/extension-highlight": "workspace:*",
    "@richkit/extension-history": "workspace:*",
    "@richkit/extension-horizontal-rule": "workspace:*",
    "@richkit/extension-image": "workspace:*",
    "@richkit/extension-italic": "workspace:*",
    "@richkit/extension-line-height": "workspace:*",
    "@richkit/extension-link": "workspace:*",
    "@richkit/extension-list-item": "workspace:*",
    "@richkit/extension-markdown-shortcuts": "workspace:*",
    "@richkit/extension-ordered-list": "workspace:*",
    "@richkit/extension-page-break": "workspace:*",
    "@richkit/extension-paragraph": "workspace:*",
    "@richkit/extension-paste-handler": "workspace:*",
    "@richkit/extension-placeholder": "workspace:*",
    "@richkit/extension-slash-commands": "workspace:*",
    "@richkit/extension-strike": "workspace:*",
    "@richkit/extension-subscript": "workspace:*",
    "@richkit/extension-superscript": "workspace:*",
    "@richkit/extension-table": "workspace:*",
    "@richkit/extension-task-list": "workspace:*",
    "@richkit/extension-text-align": "workspace:*",
    "@richkit/extension-text-style": "workspace:*",
    "@richkit/extension-track-changes": "workspace:*",
    "@richkit/extension-typography": "workspace:*",
    "@richkit/extension-underline": "workspace:*",
    "@richkit/extension-word-count": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faithdevss/rich_editor.git",
    "directory": "packages/starter-kit"
  },
  "homepage": "https://github.com/faithdevss/rich_editor#readme",
  "bugs": {
    "url": "https://github.com/faithdevss/rich_editor/issues"
  },
  "sideEffects": false,
  "keywords": [
    "rich-text",
    "editor",
    "wysiwyg",
    "prosemirror"
  ]
}
