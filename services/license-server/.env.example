# Copy to .env on the server (chmod 600) and fill in. The service reads plain
# environment variables; the systemd unit loads this file.

# Lemon Squeezy → Settings → Webhooks → your endpoint → signing secret.
# Without it the service refuses to start: an unverified endpoint mints free keys.
LS_WEBHOOK_SECRET=

# Variant ids from Lemon Squeezy (Products → variant → the id in the URL).
# Comma-separate when a plan has monthly and yearly variants.
VARIANT_STARTUP=
VARIANT_BUSINESS=
VARIANT_LIFETIME=

# The ECDSA P-256 private key made by `pnpm license:keygen`. Keep it outside
# this folder, owned by the service user, mode 600. Back it up: lose it and no
# key existing builds accept can ever be minted again.
RICHKIT_LICENSE_PRIVATE_KEY=/home/richkit/.richkit/license-private.jwk

# Optional but recommended: the `x` coordinate from
# packages/license/src/public-key.ts. The service refuses to start if the
# private key is not that pair, which catches minting keys no build will trust.
EXPECTED_PUBLIC_KEY_X=

# Mail. resend (default) or postmark.
MAIL_PROVIDER=resend
RESEND_API_KEY=
# POSTMARK_API_KEY=
MAIL_FROM=RichKit <licenses@yourdomain.com>
# Keep a copy of every key email.
MAIL_BCC=

# Append-only record of issued keys. Back this up with the private key.
ORDERS_FILE=/var/lib/richkit-license/orders.jsonl

# Bound to loopback; nginx or Caddy terminates TLS in front.
HOST=127.0.0.1
PORT=8787
